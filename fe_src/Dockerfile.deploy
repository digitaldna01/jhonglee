# CI image: the site is built natively on the GitHub runner (npm ci && npm run
# build — see .github/workflows/deploy.yml) and only the static output is
# copied into an arm64 nginx. Building Vite + shiki + Tailwind under QEMU
# emulation took >17 minutes per deploy; this stage takes seconds.
# Local prod-like builds (docker-compose.local.yml) still use ./Dockerfile,
# which runs the npm build inside the image.
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
