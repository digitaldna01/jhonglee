# Dev-only image — runs the Vite dev server (HMR) instead of building + nginx.
# Used by docker-compose.dev.yml. The source tree is bind-mounted at runtime,
# so this image only needs node_modules baked in (kept off the bind mount via
# an anonymous volume in compose).
FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
