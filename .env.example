# Local only. Copy to .env (gitignored) next to the compose file you run.
#   ANTHROPIC_API_KEY  optional — without it chat answers are retrieval-only
#   POSTGRES_PASSWORD  optional locally (defaults to "jhonglee")
# After editing, recreate the backend so it re-reads the env:
#   docker compose -f docker-compose.dev.yml up -d backend
#
# Production (Pi) does NOT use this file: the deploy workflow writes .env from
# GitHub repository secrets (ANTHROPIC_API_KEY, POSTGRES_PASSWORD) on every run,
# because actions/checkout wipes untracked files.
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=
# optional: chat rate limits (defaults 10/min, 100/day per visitor and per IP)
# CHAT_RATE_PER_MINUTE=10
# CHAT_RATE_PER_DAY=100
