{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(curl -s http://localhost:5174)",
      "WebFetch(domain:localhost)",
      "Bash(pkill -f \"vite --port 5174\")",
      "WebFetch(domain:api.anthropic.com)",
      "Bash(curl -s --max-filesize 5000000 \"https://api.anthropic.com/v1/design/h/nUjVjxOu6bcWvfhWCj7aPQ?open_file=Brain+View.html\" -o /tmp/design_file.html)",
      "Read(//tmp/**)",
      "Bash(curl -L -s \"https://api.anthropic.com/v1/design/h/nUjVjxOu6bcWvfhWCj7aPQ?open_file=Brain+View.html\" -o /tmp/design_file.html --max-time 20)",
      "Read(//private/tmp/**)",
      "Bash(cp /tmp/design_file.html /tmp/design_file.gz)",
      "Bash(gunzip -f /tmp/design_file.gz)",
      "Bash(mkdir -p /tmp/design_extract)",
      "Bash(tar -xf /tmp/design_file -C /tmp/design_extract)"
    ]
  }
}
